# Hugo build output. All of it is regenerated from content/, layouts/, and
# static/ by running `make build`.
/public/
/resources/
.hugo_build.lock

# The resume is rendered from resume/*.adoc by `make resume`, and again by CI
# on every deploy. Only the AsciiDoc source is worth committing.
/static/resume/
/static/resume.pdf

# devbox and direnv. devbox.json and devbox.lock ARE committed; the rest is
# local machine state. .envrc is shared, .envrc.local is yours alone.
.devbox/
.envrc.*
!.envrc

# process-compose leaves these behind while `make dev` is running.
.pc_*

# Python bytecode, from running the tests that sit beside the code snippets.
__pycache__/
*.pyc

.DS_Store
Thumbs.db
